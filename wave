        if CheatConfig.Fly and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            Cheat:Fly()
        end

        if CheatConfig.NoClip then
            Cheat:NoClip()
        end

        if CheatConfig.HighJump then
            Cheat:HighJump()
        end

        if CheatConfig.ESP then
            Cheat:ESP()
        end
    end)

    -- Water Effect (subtle)
    local waterEffect = Instance.new("Frame")
    waterEffect.Size = UDim2.new(1, 0, 1, 0)
    waterEffect.BackgroundTransparency = 1
    waterEffect.ZIndex = -1
    waterEffect.Parent = MainFrame

    for i = 1, 16 do
        local drop = Instance.new("Frame")
        drop.Size = UDim2.new(0, 2, 0, math.random(8, 18))
        drop.Position = UDim2.new(math.random() * 0.9, 0, -0.1, 0)
        drop.BackgroundColor3 = W4VE_COLORS.Accent
        drop.BackgroundTransparency = 0.75
        drop.BorderSizePixel = 0
        drop.ZIndex = -1
        drop.Parent = waterEffect

        spawn(function()
            while drop and drop.Parent do
                local pos = drop.Position
                local newY = pos.Y.Scale + 0.006
                if newY > 1.1 then
                    drop.Position = UDim2.new(math.random() * 0.9, 0, -0.1, 0)
                else
                    drop.Position = UDim2.new(pos.X.Scale, pos.X.Offset, newY, pos.Y.Offset)
                end
                wait(0.09)
            end
        end)
    end

    print("W4VE inlined: UI loaded.")
end

