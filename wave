function KeySystem:setButtonState(enabled)
    local btn = self.validateBtn
    btn.Active = enabled
    btn.AutoButtonColor = enabled
    btn.BackgroundTransparency = enabled and 0 or 0.5
    btn.Text = enabled and Config.KeySystem.ButtonText or "Locked"
end

function KeySystem:showStatus(msg, col, sound)
    local s = self.statusLabel
    if not s then return end
    s.Text = msg
    s.TextColor3 = col
    s.TextTransparency = 0
    
    if sound == "success" and self.successSound then
        pcall(function() self.successSound:Play() end)
    elseif sound == "error" and self.errorSound then
        pcall(function() self.errorSound:Play() end)
    end
    
    task.delay(2, function()
        if s and s.Parent then
            s:TweenSize(UDim2.new(0.8, 0, 0, 0), "Out", "Quad", 0.4, true, function()
                s.Text = ""
                s.TextTransparency = 1
                s:TweenSize(UDim2.new(0.8, 0, 0, 40), "Out", "Quad", 0, true)
            end)
        end
    end)
end

function KeySystem:lockAll(duration)
    self.locked = true
    self:setButtonState(false)
    self.keyBox.TextEditable = false
    self:showStatus(string.format(Config.KeySystem.LockedText, duration), Config.KeySystem.ErrorColor)
    delay(duration, function()
        self.locked = false
        self.attempts = 0
        self:setButtonState(true)
        self.keyBox.TextEditable = true
        self.statusLabel.Text = ""
    end)
end

function KeySystem:CheckKey()
    if self.locked then return end
    if self.checking then return end
    
    local entered = self.keyBox.Text:upper():gsub("%s+","")
    if entered == "" then
        self:showStatus("Please enter a key.", Config.KeySystem.ErrorColor)
        return
    end

    self.checking = true
    self:animateButton("loading")
    task.wait(0.3)

    if ValidKeySet[entered] then
        self:showStatus(Config.KeySystem.SuccessText, Config.KeySystem.SuccessColor, "success")
        task.wait(1)
        if self.screen then
            self.screen:Destroy()
        end
        self.checking = false
        LoadMainScript()
        return
    else
        self.attempts = (self.attempts or 0) + 1
        self:showStatus(Config.KeySystem.ErrorText, Config.KeySystem.ErrorColor, "error")
        self.keyBox:TweenPosition(self.keyBox.Position + UDim2.new(0.02,0,0,0),"Out","Quad",0.1,true,function()
            if self.keyBox and self.keyBox.Parent then
                self.keyBox:TweenPosition(UDim2.new(0.1,0,0.3,0),"Out","Quad",0.1,true)
            end
        end)
        if Config.KeySystem.MaxAttempts and self.attempts >= Config.KeySystem.MaxAttempts then
            self:lockAll(Config.KeySystem.LockoutTime or 30)
        else
            self:animateButton("idle")
        end
        self.checking = false
    end
end

function KeySystem:animateButton(state)
    local btn = self.validateBtn
    if state == "loading" then
        btn.Text = "Checking..."
        btn.Active = false
        btn.AutoButtonColor = false
        btn.BackgroundTransparency = 0.5
    elseif state == "idle" then
        self:setButtonState(false)
    else
        self:setButtonState(true)
    end
end

function KeySystem:Start()
    self:CreateUI()
    self.attempts = 0
    self.locked = false
    self.checking = false
end

if Config.KeySystem.Enabled then
    KeySystem:Start()
else
    LoadMainScript()
end

