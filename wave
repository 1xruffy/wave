    -- CHEAT FUNCTIONS
    local Cheat = {}

    function Cheat:IsEnemy(player)
        if player == LocalPlayer then return false end
        if not player.Character then return false end

        if game:FindService("Teams") and LocalPlayer.Team then
            return player.Team ~= LocalPlayer.Team
        end

        return true
    end

    function Cheat:GetClosestTarget()
        local closest = nil
        local closestDist = CheatConfig.FOV

        for _, player in pairs(Players:GetPlayers()) do
            if self:IsEnemy(player) and player.Character then
                local head = player.Character:FindFirstChild("Head")
                if head then
                    local screenPos = Workspace.CurrentCamera:WorldToScreenPoint(head.Position)
                    if screenPos.Z > 0 then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                        if dist < closestDist then
                            closest = player
                            closestDist = dist
                        end
                    end
                end
            end
        end

        return closest
    end

    -- AIMBOT
    function Cheat:Aimbot()
        if not CheatConfig.Aimbot then return end

        local target = self:GetClosestTarget()
        if not target or not target.Character then return end

        local head = target.Character:FindFirstChild("Head")
        if not head then return end

        local camera = Workspace.CurrentCamera
        local targetCF = CFrame.lookAt(camera.CFrame.Position, head.Position)
        local smoothCF = camera.CFrame:Lerp(targetCF, CheatConfig.Smoothness)

        camera.CFrame = smoothCF
    end

    -- TARGET LOCK
    function Cheat:TargetLock()
        if not CheatConfig.TargetLock then return end

        local target = self:GetClosestTarget()
        if not target or not target.Character then return end

        local camera = Workspace.CurrentCamera
        local aimPart = nil

        if CheatConfig.HeadLock then
            aimPart = target.Character:FindFirstChild("Head")
        else
            aimPart = target.Character:FindFirstChild("HumanoidRootPart") or 
                      target.Character:FindFirstChild("Torso") or
                      target.Character:FindFirstChild("UpperTorso")
        end

        if not aimPart then return end

        local targetCF = CFrame.lookAt(camera.CFrame.Position, aimPart.Position)
        camera.CFrame = camera.CFrame:Lerp(targetCF, 0.8)

        if CheatConfig.AutoShoot then
            pcall(function() mouse1click() end)
        end
    end

    -- RAGEBOT
    function Cheat:Ragebot()
        if not CheatConfig.Ragebot then return end

        for _, player in pairs(Players:GetPlayers()) do
            if self:IsEnemy(player) and player.Character then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    if math.random(1, 100) <= CheatConfig.HitChance then
                        humanoid.Health = 0

                        if CheatConfig.AutoShoot then
                            for i = 1, 3 do
                                pcall(function() mouse1click() end)
                                wait(0.05)
                            end
                        end
                    end
                end
            end
        end
    end

    -- BULLET TP
    function Cheat:BulletTP()
        if not CheatConfig.BulletTP then return end

        local char = LocalPlayer.Character
        if not char then return end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local target = self:GetClosestTarget()
        if not target or not target.Character then return end

        local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return end

        local direction = (targetRoot.Position - root.Position).Unit
        local tpPos = targetRoot.Position - (direction * CheatConfig.TPDistance)

        root.CFrame = CFrame.new(tpPos)
    end

    -- FLY HACK (shared helpers)
    local TweenService = game:GetService("TweenService")
    local flying = false
    local alignPosition = nil
    local alignOrientation = nil
    local rootPart = nil
    local noclipConn = nil
    local flyConn = nil
    local jumpConn = nil

    local function setupFly()
        local character = LocalPlayer.Character
        if not character then return end
        rootPart = character:WaitForChild("HumanoidRootPart")

        if alignPosition then alignPosition:Destroy() end
        if alignOrientation then alignOrientation:Destroy() end

        local rootAttachment0 = Instance.new("Attachment")
        rootAttachment0.Name = "FlyAttach0"
        rootAttachment0.Parent = rootPart

        local rootAttachment1 = Instance.new("Attachment")
        rootAttachment1.Name = "FlyAttach1"
        rootAttachment1.Parent = rootPart

        alignPosition = Instance.new("AlignPosition")
        alignPosition.Name = "FlyAlignPos"
        alignPosition.Attachment0 = rootAttachment0
        alignPosition.Attachment1 = rootAttachment1
        alignPosition.MaxForce = 10000
        alignPosition.MaxVelocity = 200
        alignPosition.Responsiveness = 200
        alignPosition.Parent = rootPart

        alignOrientation = Instance.new("AlignOrientation")
        alignOrientation.Name = "FlyAlignOri"
        alignOrientation.Attachment0 = rootAttachment0
        alignOrientation.Attachment1 = rootAttachment1
        alignOrientation.MaxTorque = 10000
        alignOrientation.MaxAngularVelocity = math.huge
        alignOrientation.Responsiveness = 200
        alignOrientation.PrimaryAxisOnly = false
        alignOrientation.Parent = rootPart

        noclipConn = RunService.Stepped:Connect(function()
            if rootPart and rootPart.Parent then
                for _, part in pairs(character:GetChildren()) do
                    if part:IsA("BasePart") and part ~= rootPart then
                        part.CanCollide = false
                    end
                end
                rootPart.CanCollide = false
            end
        end)
    end

    local function destroyFly()
        if alignPosition then alignPosition:Destroy() end
        if alignOrientation then alignOrientation:Destroy() end
        if noclipConn then noclipConn:Disconnect() end
        if flyConn then flyConn:Disconnect() end
        flying = false
    end

    local function updateFly()
        if not flying or not rootPart or not Workspace.CurrentCamera then return end

        local moveVector = Vector3.new(0, 0, 0)
        local camCFrame = Workspace.CurrentCamera.CFrame

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveVector = moveVector + camCFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveVector = moveVector - camCFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveVector = moveVector - camCFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveVector = moveVector + camCFrame.RightVector
        end

        local speed = CheatConfig.FlySpeed or 80
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveVector = moveVector + camCFrame.UpVector * 1.5
            speed = (CheatConfig.FlySpeed or 80) * 1.8
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveVector = moveVector - camCFrame.UpVector
        end

        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            speed = (CheatConfig.FlySpeed or 80) * 1.2
        end

        if moveVector.Magnitude > 0 then
            moveVector = moveVector.Unit * speed
        end

        local targetCFrame = camCFrame + camCFrame.LookVector * 5
        targetCFrame = CFrame.new(targetCFrame.Position + moveVector * 0.1, targetCFrame.Position + camCFrame.LookVector)

        if alignPosition and rootPart then
            alignPosition.Position = targetCFrame.Position
        end
    end

    local function onJump()
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if humanoid and not flying then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end

